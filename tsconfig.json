{
  "compilerOptions": {
    "target": "ESNext", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "esModuleInterop": true, "skipLibCheck": true,
    "allowJs": true, "resolveJsonModule": true, "isolatedModules": true,
    "verbatimModuleSyntax": true, "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"], "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "vite.config.ts"]
}
