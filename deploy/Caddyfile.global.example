# Optional global options. Merge these into the existing global options block at
# the top of the root Caddyfile; a Caddyfile can have only one such block.
{
    # Global ACME DNS challenge via Cloudflare plugin (if using Cloudflare DNS token)
    # acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}

    # Optional: Tighten server timeouts against Slowloris when directly exposed without DDoS proxy
    # servers {
    #     timeouts {
    #         read_body 10s
    #         read_header 10s
    #         write 30s
    #         idle 1m
    #     }
    #     max_header_size 16kb
    # }
}
