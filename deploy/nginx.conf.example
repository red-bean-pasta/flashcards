# Example for inclusion in nginx's http {} context. Replace the hostname,
# certificate paths and static root before use. Only put built public assets
# in this directory: nginx serves files beneath it without application auth.
limit_req_zone $binary_remote_addr zone=flashcards_requests:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=flashcards_connections:10m;

server {
    listen 80;
    listen [::]:80;
    server_name flashcards.example.com;
    return 308 https://flashcards.example.com$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name flashcards.example.com;
    ssl_certificate /etc/letsencrypt/live/flashcards.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/flashcards.example.com/privkey.pem;

    root /srv/flashcards/dist;
    index index.html;
    server_tokens off;
    limit_req zone=flashcards_requests burst=30 nodelay;
    limit_req_status 429;
    limit_conn flashcards_connections 20;
    limit_conn_status 429;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    # OneDrive supplies dynamic HTTPS download URLs, so connect-src https: is
    # broader than Microsoft domains. This CSP needs live integration testing.
    # img-src blocks remote Markdown images unless explicitly allowlisted.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https:; frame-src https://onedrive.live.com https://login.microsoftonline.com https://login.live.com; form-action 'self' https://onedrive.live.com; frame-ancestors 'none'; base-uri 'none'; object-src 'none'" always;

    # Never route legacy API requests to a retired materials server.
    location = /api { return 404; }
    location ^~ /api/ { return 404; }
    location / {
        limit_except GET { deny all; }
        try_files $uri $uri/ =404;
    }
}
