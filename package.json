{
  "name": "flashcards",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --import tsx server/index.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.server.json --noEmit",
    "test": "node --import tsx --test --test-reporter=spec tests/*.test.ts",
    "build": "npm run check && vite build && tsc -p tsconfig.server.json",
    "start": "node build/server/index.js"
  },
  "dependencies": {
    "chokidar": "^6.0.0",
    "express": "^5.3.0",
    "marked": "^18.1.1",
    "mdast-util-from-markdown": "^2.1.0",
    "sanitize-html": "^2.18.1",
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/sanitize-html": "^2.16.2",
    "svelte-check": "^4.7.7",
    "tsx": "^4.23.15",
    "vite": "^8.3.5"
  }
}
