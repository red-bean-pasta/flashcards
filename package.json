{
  "name": "flashcards",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host localhost",
    "dev:web": "vite --host localhost",
    "preview:web": "vite preview --host localhost",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --import tsx --test --test-reporter=spec tests/*.test.ts",
    "build": "npm run check && vite build"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "mdast-util-from-markdown": "^2.1.0",
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.5",
    "svelte-check": "^4.7.7",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  }
}
